{
  "name": "proxy-manager",
  "version": "1.0.3",
  "description": "Browser extension to manage proxies from a compact popup.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.1.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite build --watch --mode development",
    "bump": "node bumpVersion.js",
    "build": "tsc && vite build",
    "build:chrome": "node bumpVersion.js && npm run build",
    "promo": "node store/promo/capture.js",
    "promo:dev": "vite --config store/promo/vite.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc",
    "format": "prettier --write ."
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "country-flag-icons": "^1.6.20",
    "lucide-react": "^1.48.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.1.43",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vite-plugin-svgr": "^5.2.0",
    "vite-plugin-zip-pack": "^1.2.4"
  }
}
